# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string (standard postgres:// protocol)
DATABASE_URL="postgres://user:password@localhost:5432/ladder"

# ─── Authentication ───────────────────────────────────────────────────
# NextAuth.js v5 secret — generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-random-32-byte-hex-string"

# ─── Application ──────────────────────────────────────────────────────
# Canonical URL of the deployed site (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ─── Optional ─────────────────────────────────────────────────────────
# Server port (defaults to 3000 if unset)
# PORT=3000
